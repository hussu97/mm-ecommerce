#!/usr/bin/env sh
#
# Mirrors the gates the "Deploy to Production" workflow runs before it will
# deploy, so a lint / format / type / shared-types-drift failure is caught here
# instead of after a full CI round trip (and after the commit is already on
# main). `set -e` so the FIRST failing check aborts the push — without it the
# script printed failures but still exited 0 on the trailing echo, so a broken
# push sailed through and only the deploy caught it.
set -e

echo "▶ pre-push: type-checking, linting and running frontend tests..."

pnpm --filter web exec tsc --noEmit
pnpm --filter admin exec tsc --noEmit
# F-OPS-12: CI (deploy.yml's test-api job doesn't touch these; deploy-web/
# deploy-admin lint as their own steps) is not the first place a lint error
# should surface. Same rule as the backend's ruff check below.
pnpm --filter web lint
pnpm --filter admin lint
pnpm --filter web test
pnpm --filter admin test

echo "▶ pre-push: linting and running backend tests..."

VENV="$(pwd)/apps/api/.venv/bin"
if [ -d "$VENV" ]; then
  # Prepended, not appended: appending leaves the system python first on the
  # PATH, and the hook then fails on a machine that has one without pytest —
  # which reads as "the tests broke" rather than "the wrong python ran".
  export PATH="$VENV:$PATH"
  cd apps/api
  # F-OPS-12: ruff runs in CI's test-api job, but a push that fails it there
  # still has to wait on a full CI round trip to find out — catch it locally
  # first, the same way the frontend lint/type-check above already do.
  ruff check .
  ruff format --check .
  # Shared-types freshness — the deploy's own gate (deploy.yml "Shared types
  # freshness": `export_openapi --check`). A Pydantic schema change that was not
  # re-exported fails the deploy here otherwise; the check needs Python only, no
  # Node and no database, so it is cheap to run before the slow pytest below.
  python -m scripts.export_openapi --check
  python -m pytest tests/ --tb=short -q
  cd - > /dev/null
else
  echo "⚠ Python venv not found at apps/api/.venv — skipping backend lint/tests"
fi

echo "✓ pre-push checks passed"
