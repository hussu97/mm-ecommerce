{
  "name": "@mm/types",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint src/",
    "test": "vitest run",
    "generate": "openapi-typescript openapi.json -o src/generated.ts",
    "check:fresh": "openapi-typescript openapi.json -o /tmp/mm-types-check.ts && diff -q /tmp/mm-types-check.ts src/generated.ts && echo 'generated.ts is current.'"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.7.0",
    "vitest": "^2.0.0"
  }
}
