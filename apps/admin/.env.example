# Always use the relative path — the Next.js proxy keeps cookies same-origin.
# The admin (vercel.app) and API (meltingmomentscakes.com) are cross-site: SameSite=Lax cookies
# are NOT sent on cross-site JS fetch calls, so using an absolute URL here causes 401 on every request.
NEXT_PUBLIC_API_URL=/api/v1
# Dev: point to local FastAPI. Prod (Vercel): set to https://api.meltingmomentscakes.com
NEXT_PRIVATE_API_HOST=http://localhost:8000
# Where relative CMS image paths (/images/banners/...) are served from — the
# storefront, not the admin. Only used to render thumbnails in the content
# editor. Dev: http://localhost:3000
NEXT_PUBLIC_STOREFRONT_URL=https://meltingmomentscakes.com

# ─── Sentry (optional) ───────────────────────────────────────────────────────
# Leave empty to disable error tracking.
# Use the DSN from Sentry project: mm-admin.
#
# NEXT_PUBLIC_SENTRY_DSN is the BROWSER DSN (inlined at build). SET `SENTRY_DSN`
# (below) IN VERCEL for the Node runtime so server-component/route-handler/
# server-action errors report — `instrumentation.ts` wires `onRequestError`, but
# only fires when the server config has a DSN at runtime. Without it there are no
# backend Sentry logs for the admin app.
NEXT_PUBLIC_SENTRY_DSN=
# Server-side DSN — set in the Vercel project env. Read first by the server/edge
# Sentry configs.
SENTRY_DSN=
# Explicit server environment; otherwise derived from VERCEL_ENV/NODE_ENV.
SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=1.0
NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0
