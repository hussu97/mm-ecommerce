# ─── App ─────────────────────────────────────────────────────────────────────
APP_ENV=development
# Production: APP_ENV=production

# ─── Nginx ───────────────────────────────────────────────────────────────────
# Set to true once SSL certificates are issued (Step 7 in PRODUCTION.md)
USE_SSL=false

# ─── Database ────────────────────────────────────────────────────────────────
# Individual vars required by docker-compose.prod.yml to initialise the Postgres container
POSTGRES_USER=mm_user
POSTGRES_PASSWORD=mm_password
POSTGRES_DB=mm_ecommerce
DATABASE_URL=postgresql+asyncpg://mm_user:mm_password@localhost:5432/mm_ecommerce
# Production: DATABASE_URL=postgresql+asyncpg://<user>:<password>@postgres:5432/<db>

# ─── Redis (caching) ─────────────────────────────────────────────────────────
# Leave empty to disable caching (API will run without it).
REDIS_URL=redis://localhost:6379/0
# Production: REDIS_URL=redis://redis:6379/0

# ─── Security ────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-a-long-random-string-here
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_EXPIRE_MINUTES=60

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
# Production: CORS_ORIGINS=["https://meltingmomentscakes.com","https://admin.meltingmomentscakes.com"]

# ─── Allowed Hosts ───────────────────────────────────────────────────────────
ALLOWED_HOSTS=["*"]
# Production: ALLOWED_HOSTS=["api.meltingmomentscakes.com"]

# ── The register API (app.pos_main) ──────────────────────────────────────────
# The POS runs as its own application on its own hostname, so it keeps its own
# host and CORS lists: the storefront's and the terminal's must not drift into
# one another. A native iPad sends no Origin, so POS_CORS_ORIGINS is usually
# empty — set it only for a browser-based terminal.
POS_ALLOWED_HOSTS=["*"]
# Production: POS_ALLOWED_HOSTS=pos.meltingmomentscakes.com
POS_CORS_ORIGINS=
# Refuse device tokens anywhere but the register app. Off by default so a
# terminal is never stranded before pos.* resolves; production sets it true.
POS_REQUIRE_POS_HOST=false

# ─── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ─── Resend (email) ──────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxx
FROM_EMAIL=orders@meltingmomentscakes.com

# ─── Cloudflare R2 (object storage) ──────────────────────────────────────────
CLOUDFLARE_R2_ACCESS_KEY=xxx
CLOUDFLARE_R2_SECRET_KEY=xxx
CLOUDFLARE_R2_BUCKET=melting-moments-cakes
CLOUDFLARE_R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_PUBLIC_URL=https://pub-<hash>.r2.dev

# ─── Tabby (BNPL) ────────────────────────────────────────────────────────────
TABBY_API_KEY=xxx
TABBY_PUBLIC_KEY=xxx
TABBY_MERCHANT_CODE=xxx

# ─── Tamara (BNPL) ───────────────────────────────────────────────────────────
TAMARA_API_KEY=xxx
TAMARA_API_URL=https://api.tamara.co

# ─── Lalamove (courier) ──────────────────────────────────────────────────────
# Leave the key and secret empty to run without a courier. Zones marked
# `lalamove` then behave exactly like third-party ones — same price, dispatched
# by hand — so a missing credential degrades to the old flow instead of
# stalling orders.
#
# The public docs omit the UAE, but production serves it: GET /v3/cities with
# Market: AE returns AE AUH / AE DXB / AE SHJ. The SANDBOX is not usable for AE
# — its pricing engine returns 500 and its wallet is unfunded — so develop
# lifecycle logic against sandbox HK and validate against production AE.
LALAMOVE_API_KEY=
LALAMOVE_API_SECRET=
LALAMOVE_ENV=production            # production | sandbox
LALAMOVE_MARKET=AE
LALAMOVE_LANGUAGE=en_AE            # validated by Lalamove to be exactly this
LALAMOVE_SERVICE_TYPE=CAR          # smallest UAE vehicle: 0.5 m³, 80 kg
# Comma-separated. Empty on purpose: DOOR_TO_DOOR cost a flat +5 AED per order
# and bought a promise drivers keep anyway. Set it back if that proves wrong.
LALAMOVE_SPECIAL_REQUESTS=
# Must match the route byte for byte AND the URL registered in the Partner
# Portal — the path is part of what the webhook signature covers.
LALAMOVE_WEBHOOK_PATH=/api/v1/webhooks/lalamove
LALAMOVE_TIMEOUT_SECONDS=8
LALAMOVE_QUOTE_CACHE_SECONDS=120
# Where a run collects from, and who the driver calls, are branch columns —
# Admin -> Branches. Nothing here selects a kitchen: a zone names its own
# branch, and anything without a zone uses the first active branch flagged
# "receives online orders" that has coordinates and a phone number.

# ─── noon Send / Rider-on-Demand (courier) ───────────────────────────────────
# The second API-booked courier. On a BIKE it is cheaper than Lalamove at every
# distance in range, surge included: AED 12 flat to 10 km, +1/km to 15, +1.5/km
# to 20, +1 during 12:00-15:00 and 19:00-22:00. In their bulky CAR product at
# AED 25 base it loses at every distance in range. Two hard limits keep it to the
# inner part of Sharjah — it cannot cross an emirate boundary, and it will not
# carry a run past 20 km — so the zone map hands it `Sharjah Central` and nothing
# else. Anything it refuses falls back to Lalamove automatically, which is also
# what happens when these are left empty.
#
# NOON_SEND_ENV stays `staging` ON PRODUCTION TOO while the trial runs. We have
# no production noon Send key, and their staging environment is real enough to
# exercise the whole pipeline — tasks are created, tracked and cancelled for
# real. What it does NOT do is dispatch a real rider, so the only accounts
# routed there are the trial ones in TRIAL_CUSTOMER_EMAILS, whose orders someone
# carries by hand. That is also why those accounts get free delivery.
NOON_SEND_API_KEY=
NOON_SEND_ENV=staging              # staging | production
NOON_SEND_LOCALE=en-ae             # en-ae | en-sa
# The outlet code lives on the branch — Admin -> Branches -> noon Send outlet
# code — because a courier collects from a place. Register one with
# `python -m scripts.register_noon_send_pickup --branch K001 --create`, which
# writes the code onto the branch. A branch without a code cannot dispatch
# through noon Send.
NOON_SEND_CLIENT_CODE=noon_food    # noon_food | nownow
# Their cap on pickup-to-drop-off. Never set this tighter than the radius
# `Sharjah Central` is drawn to (20 road km) or the outer ring of the zone is
# refused before noon Send sees it. GET /public/v1/configurations reports the
# real per-partner limit if commercial ever raise ours.
NOON_SEND_MAX_DISTANCE_M=20000
# Straight-line to road-distance multiplier, fitted on the sixteen Sharjah areas
# the Lalamove rate card was measured over. There is no quotation API, so this
# is how the cost of a noon Send run is estimated.
NOON_SEND_DETOUR_FACTOR=1.49
# The rate card's two vehicle tiers. Standard cakes go by bike; the bulky car
# rate is here so a large one can be costed honestly rather than silently priced
# as a bike.
NOON_SEND_BASE=12
NOON_SEND_BULKY_BASE=25
NOON_SEND_SURGE_AED=1
# The key noon Send presents on the status and tracking webhooks. They do not
# sign requests, so this is the only thing separating a real status update from
# anyone who guesses the URL. Empty rejects every push.
NOON_SEND_WEBHOOK_API_KEY=
NOON_SEND_TIMEOUT_SECONDS=8

# ─── Trial customers ─────────────────────────────────────────────────────────
# The accounts running live tests against production. Matched against a
# SIGNED-IN customer's own address — a guest checkout never qualifies, because
# an email is a string anybody may type into a box.
#
# Two things follow, and they are two halves of one decision: noon Send carries
# the order, and delivery is free. This list is the only thing gating noon Send
# and it applies in every environment, so no deployment setting can widen it.
# Empty ends the trial: noon Send opens to every customer in its zone and nobody
# gets free delivery.
TRIAL_CUSTOMER_EMAILS=h_abbasi97@hotmail.com

# ─── Apple Push (waking the POS registers) ───────────────────────────────────
# The APNs auth key, as .p8 PEM. Team-scoped and account-wide: ONE key serves
# every app in the Apple team and both the sandbox and production hosts, and
# Apple caps an account at two — so this is the same key the other apps use, not
# a new one. Ours is Key ID CWXGV3TWNY, Team 2F94NY8R3T, local copy at
# ~/.apns/AuthKey_CWXGV3TWNY.p8 (Apple serves the file exactly once — back it up).
#
# As a GitHub secret it must be ONE LINE with literal \n between the PEM lines,
# because a multi-line secret does not survive the printf into .env. Convert with:
#   awk 'BEGIN{ORS="\\n"} {print}' ~/.apns/AuthKey_CWXGV3TWNY.p8
#
# Empty means no push: orders still arrive and the register still shows them
# when it polls, so this is a quieter shop rather than a broken one.
APNS_KEY_P8=
APNS_KEY_ID=
APNS_TEAM_ID=
# Bundled in the app. The repeating alarm is the app's own doing — iOS will not
# loop a notification sound, so the push is the doorbell and the app is the bell.
APNS_ORDER_SOUND=new-order.caf
APNS_TIMEOUT_SECONDS=10

# ─── Frontend URLs (used in email templates) ─────────────────────────────────
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
# Production: WEB_URL=https://meltingmomentscakes.com
# Production: ADMIN_URL=https://admin.meltingmomentscakes.com

# ─── Umami Cloud Analytics (optional) ────────────────────────────────────────
# Leave empty to disable traffic metrics on the analytics dashboard.
# Create an API key at: https://cloud.umami.is/settings/api-keys
UMAMI_API_KEY=
UMAMI_WEBSITE_ID=

# ─── GCP Cloud Logging ────────────────────────────────────────────────────────
# Project ID for the gcplogs Docker logging driver (docker-compose.prod.yml).
# On GCE instances the driver auto-detects the project — you can leave this
# empty. Only set it when running outside GCE (e.g. local test of prod compose).
# Prereq: VM service account must have roles/logging.logWriter.
GCP_PROJECT_ID=

# ─── Sentry (error tracking, optional) ───────────────────────────────────────
# Leave empty to disable. Use the DSN from Sentry project: mm-backend.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0
# Production: SENTRY_ENVIRONMENT=production

# ─── Cloudflare Turnstile (bot check on signup and password reset) ───────────
# Empty disables the check entirely, at both ends — the storefront renders no
# widget and the API asks for no token. That is deliberate: deploying before
# the keys exist must not lock real customers out of signing up.
#
# Keys: dash.cloudflare.com -> Turnstile -> Add site. The widget key is public
# and belongs in the web app as NEXT_PUBLIC_TURNSTILE_SITE_KEY; the secret goes
# here. Cloudflare's always-passes test secret is 1x0000000000000000000000000000000AA
# and its always-fails twin is 2x0000000000000000000000000000000AA — both are
# answered locally without touching the network.
TURNSTILE_SECRET_KEY=
TURNSTILE_TIMEOUT_SECONDS=5
