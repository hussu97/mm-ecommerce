# ─── App ─────────────────────────────────────────────────────────────────────
APP_ENV=development
# Production: APP_ENV=production

# ─── Nginx ───────────────────────────────────────────────────────────────────
# Set to true once SSL certificates are issued (Step 7 in PRODUCTION.md)
USE_SSL=false

# ─── Database ────────────────────────────────────────────────────────────────
# Individual vars required by docker-compose.prod.yml to initialise the Postgres container
POSTGRES_USER=mm_user
POSTGRES_PASSWORD=mm_password
POSTGRES_DB=mm_ecommerce
DATABASE_URL=postgresql+asyncpg://mm_user:mm_password@localhost:5432/mm_ecommerce
# Production: DATABASE_URL=postgresql+asyncpg://<user>:<password>@postgres:5432/<db>

# ─── Redis (caching) ─────────────────────────────────────────────────────────
# Leave empty to disable caching (API will run without it).
REDIS_URL=redis://localhost:6379/0
# Production: REDIS_URL=redis://redis:6379/0

# ─── Security ────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-a-long-random-string-here
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_EXPIRE_MINUTES=60

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
# Production: CORS_ORIGINS=["https://meltingmomentscakes.com","https://admin.meltingmomentscakes.com"]

# ─── Allowed Hosts ───────────────────────────────────────────────────────────
ALLOWED_HOSTS=["*"]
# Production: ALLOWED_HOSTS=["api.meltingmomentscakes.com"]

# ── The register API (app.pos_main) ──────────────────────────────────────────
# The POS runs as its own application on its own hostname, so it keeps its own
# host and CORS lists: the storefront's and the terminal's must not drift into
# one another. A native iPad sends no Origin, so POS_CORS_ORIGINS is usually
# empty — set it only for a browser-based terminal.
POS_ALLOWED_HOSTS=["*"]
# Production: POS_ALLOWED_HOSTS=pos.meltingmomentscakes.com
POS_CORS_ORIGINS=
# Refuse device tokens anywhere but the register app. Off by default so a
# terminal is never stranded before pos.* resolves; production sets it true.
POS_REQUIRE_POS_HOST=false

# ─── Stripe (card gateway) ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ─── Ziina (the second card gateway) ─────────────────────────────────────────
# Which processor settles a card is decided at runtime from the
# `payment_gateways` table, not from here — these are only the credentials.
#
# PRODUCTION RUNS ON STRIPE. Ziina exists so that a Stripe incident is a row
# update rather than a deploy, and three separate things have to be true before
# it takes a single live payment: the `payment_gateways` row is active (it ships
# inactive), ZIINA_ENABLED is true (default false, in this file, in `Settings`,
# and in docker-compose.prod.yml), and a key is present. The admin also refuses
# to activate a gateway with no credentials, so the toggle can exist on
# production and do nothing.
#
# For local work: set ZIINA_ENABLED=true, ZIINA_TEST_MODE=true, paste a test
# key, activate the row in the admin, and pay with 4242 4242 4242 4242.
ZIINA_ENABLED=false
ZIINA_API_KEY=
# The secret you registered with Ziina's `POST /webhook`. Ziina signs the raw
# body with it as a hex SHA-256 HMAC in `X-Hmac-Signature`. Without it the
# webhook endpoint refuses every push rather than trusting an unsigned one —
# `ziina_provider.register_webhook()` sets both URL and secret in one call.
ZIINA_WEBHOOK_SECRET=
ZIINA_API_URL=https://api-v2.ziina.com/api
# Sends `test: true` on every payment intent: takes test cards, charges nothing.
ZIINA_TEST_MODE=false
ZIINA_TIMEOUT_SECONDS=10

# ─── Resend (email) ──────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxx
FROM_EMAIL=noreply@meltingmomentscakes.com

# ─── Cloudflare R2 (object storage) ──────────────────────────────────────────
CLOUDFLARE_R2_ACCESS_KEY=xxx
CLOUDFLARE_R2_SECRET_KEY=xxx
CLOUDFLARE_R2_BUCKET=melting-moments-cakes
CLOUDFLARE_R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_PUBLIC_URL=https://pub-<hash>.r2.dev

# ─── Tabby (BNPL) ────────────────────────────────────────────────────────────
TABBY_API_KEY=xxx
TABBY_PUBLIC_KEY=xxx
TABBY_MERCHANT_CODE=xxx

# ─── Tamara (BNPL) ───────────────────────────────────────────────────────────
TAMARA_API_KEY=xxx
TAMARA_API_URL=https://api.tamara.co

# ─── Lalamove (courier) ──────────────────────────────────────────────────────
# Leave the key and secret empty to run without a courier. Zones marked
# `lalamove` then behave exactly like third-party ones — same price, dispatched
# by hand — so a missing credential degrades to the old flow instead of
# stalling orders.
#
# The public docs omit the UAE, but production serves it: GET /v3/cities with
# Market: AE returns AE AUH / AE DXB / AE SHJ. The SANDBOX is not usable for AE
# — its pricing engine returns 500 and its wallet is unfunded — so develop
# lifecycle logic against sandbox HK and validate against production AE.
LALAMOVE_API_KEY=
LALAMOVE_API_SECRET=
LALAMOVE_ENV=production            # production | sandbox
LALAMOVE_MARKET=AE
LALAMOVE_LANGUAGE=en_AE            # validated by Lalamove to be exactly this
LALAMOVE_SERVICE_TYPE=CAR          # smallest UAE vehicle: 0.5 m³, 80 kg
# Comma-separated. Empty on purpose: DOOR_TO_DOOR cost a flat +5 AED per order
# and bought a promise drivers keep anyway. Set it back if that proves wrong.
LALAMOVE_SPECIAL_REQUESTS=
# Must match the route byte for byte AND the URL registered in the Partner
# Portal — the path is part of what the webhook signature covers.
LALAMOVE_WEBHOOK_PATH=/api/v1/webhooks/lalamove
LALAMOVE_TIMEOUT_SECONDS=8
LALAMOVE_QUOTE_CACHE_SECONDS=120
# Where a run collects from, and who the driver calls, are branch columns —
# Admin -> Branches. Nothing here selects a kitchen: a zone names its own
# branch, and anything without a zone uses the first active branch flagged
# "receives online orders" that has coordinates and a phone number.

# ─── noon Send / Rider-on-Demand (courier) ───────────────────────────────────
# The second API-booked courier. On a BIKE it is cheaper than Lalamove at every
# distance in range, surge included: AED 12 flat to 10 km, +1/km to 15, +1.5/km
# to 20, +1 during 12:00-15:00 and 19:00-22:00. In their bulky CAR product at
# AED 25 base it loses at every distance in range. Two hard limits keep it to the
# inner part of Sharjah — it cannot cross an emirate boundary, and it will not
# carry a run past 20 km — so the zone map hands it `Sharjah Central` and nothing
# else. Anything it refuses falls back to Lalamove automatically, which is also
# what happens when these are left empty.
#
# NOON_SEND_ENV picks the fleet, and it is now the only thing between a
# customer's cake and a real rider: every order in a `noon_send` zone goes to
# noon Send. A `staging` task is created, tracked and cancelled for real and
# collected by nobody, so `production` is the default and the key must match
# whichever this names.
NOON_SEND_API_KEY=
NOON_SEND_ENV=production           # staging | production
NOON_SEND_LOCALE=en-ae             # en-ae | en-sa
# The outlet code lives on the branch — Admin -> Branches -> noon Send outlet
# code — because a courier collects from a place. Register one with
# `python -m scripts.register_noon_send_pickup --branch K001 --create`, which
# writes the code onto the branch. A branch without a code cannot dispatch
# through noon Send.
NOON_SEND_CLIENT_CODE=noon_food    # noon_food | nownow
# Their cap on pickup-to-drop-off. Never set this tighter than the radius
# `Sharjah Central` is drawn to (20 road km) or the outer ring of the zone is
# refused before noon Send sees it. GET /public/v1/configurations reports the
# real per-partner limit if commercial ever raise ours.
NOON_SEND_MAX_DISTANCE_M=20000
# Straight-line to road-distance multiplier, fitted on the sixteen Sharjah areas
# the Lalamove rate card was measured over. There is no quotation API, so this
# is how the cost of a noon Send run is estimated.
NOON_SEND_DETOUR_FACTOR=1.49
# The rate card's two vehicle tiers. Standard cakes go by bike; the bulky car
# rate is here so a large one can be costed honestly rather than silently priced
# as a bike.
NOON_SEND_BASE=12
NOON_SEND_BULKY_BASE=25
NOON_SEND_SURGE_AED=1
# The key noon Send presents on the status and tracking webhooks. They do not
# sign requests, so this is the only thing separating a real status update from
# anyone who guesses the URL. Empty rejects every push.
NOON_SEND_WEBHOOK_API_KEY=
# Whether a push that does not present the key above is refused. Off, because
# turning it on blind is the failure it prevents: noon Send's staging side sends
# a key no screen of ours produced, and enforcing a match once discarded every
# status update for the trial. Every `webhook_logs` row records the fingerprint
# they sent next to the one we hold — compare them, then set this to true.
NOON_SEND_ENFORCE_WEBHOOK_KEY=false
NOON_SEND_TIMEOUT_SECONDS=8

# ── GrubOps (GrubTech aggregator console) ────────────────────────────────────
# Mirrors "mark out of stock" from the terminal onto Noon, Talabat and Deliveroo
# so it is only said once. One way: this app is the source of truth.
# Leave GRUBOPS_SYNC_ENABLED false until the item map has been seeded AND
# approved in the admin console, or a half-built map takes the wrong things off
# the aggregators. GrubTech publish no partner API, so this signs in as a
# console user — GRUBOPS_PASSWORD is a real password and belongs in secrets.
GRUBOPS_SYNC_ENABLED=false
GRUBOPS_USERNAME=
GRUBOPS_PASSWORD=
GRUBOPS_PARTNER_ID=6922fe267f5b1c6d208c634f
# GrubOps 2.0 console app client. order-force-complete authorises on the token
# aud, so only the console client works — the integration client 2d8lmtmc… 403s.
# It is a superset for reads too. See docs/grubops-integration.md.
GRUBOPS_COGNITO_CLIENT_ID=75n3em3l16kvhnf6c512680vm9
GRUBOPS_COGNITO_REGION=eu-west-2
GRUBOPS_API_BASE=https://internal-api.grubtech.io
GRUBOPS_CATALOG_API_BASE=https://api-grubone.grubtech.io
# Deliberately the string GrubOps' own console stamps, so our records are
# indistinguishable from theirs. See core/config.py.
GRUBOPS_SOURCE=grubOps 2.0
GRUBOPS_TIMEOUT_SECONDS=8
GRUBOPS_RECONCILE_TICK_SECONDS=120
# Order ingest: pull aggregator orders from GrubOps into MM (source=aggregator).
# Off until watched once in production. Reuses the OOS credentials above.
GRUBOPS_ORDERS_ENABLED=false
GRUBOPS_ORDERS_API_BASE=https://api-grubops.grubtech.io
GRUBOPS_ORDERS_TICK_SECONDS=60
# How long a packed aggregator order waits before the ingest loop closes it to
# delivered itself. The aggregator sends no on-the-way/delivered signal once its
# rider is called, so from our side the order is done a few minutes after packing.
# Resolved at the poll tick, so the real delay rounds up to the next tick.
AGG_AUTO_CLOSE_SECONDS=300
# Foodics order write-back: drive the aggregator order forward on Foodics (the POS
# behind GrubTech) instead of GrubOps' force-* overrides. Packed dispatches it,
# the 5-min auto-close finalises it, a cancel declines it. Off until watched once
# in production.
# This is the CONSOLE integration, not the Foodics developer/OAuth API: we sign in
# as the business the way console.foodics.com does (account number + email +
# password) and call its private core-api. The session cookie + CSRF are obtained
# by that login at runtime — nothing to paste. Login presents as Chrome in the UAE,
# which is what a person at the console looks like.
FOODICS_ORDER_PUSH_ENABLED=false
FOODICS_CONSOLE_BASE=https://console.foodics.com
FOODICS_ACCOUNT_NUMBER=862261
FOODICS_EMAIL=
FOODICS_PASSWORD=
FOODICS_TIMEOUT_SECONDS=8

# ── Aggregator ingestion (Careem/Deliveroo/Talabat/Noon/Keeta) ───────────────
# The hourly sales sweep and daily finance/reconciliation sweep that mirror each
# marketplace's own ledger into aggregator_* and reconcile it against MM orders.
# Off until a session is bootstrapped and the ingest watched once — a wrong
# outlet map writes nonsense into the reconciliation. Storefront only.
AGGREGATOR_INGEST_ENABLED=false
# Fernet key encrypting the derived session blobs at rest in aggregator_session.
# Empty means no session can be stored or read, so the ingest stays inert rather
# than holding a marketplace's credentials in plaintext. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AGGREGATOR_CONFIG_ENCRYPTION_KEY=
# Bearer the bootstrap/warmer worker presents to POST /aggregators/session. The
# one write path into aggregator_session, so an empty token closes it.
AGGREGATOR_SESSION_PUSH_TOKEN=
# How often the sales sweep runs; it re-pulls a rolling window each tick because
# orders mutate after creation (confirmed->delivered->refunded).
AGGREGATOR_SALES_TICK_SECONDS=3600
# How far back the sales sweep re-pulls each tick, to catch status/refund changes.
AGGREGATOR_SALES_WINDOW_HOURS=3
# How often the finance sweep runs. Statements/payouts publish weekly, so a daily
# check is ample and keeps off the marketplaces' rate limits.
AGGREGATOR_FINANCE_TICK_SECONDS=86400
AGGREGATOR_TIMEOUT_SECONDS=20.0

# ─── Slider (courier) ────────────────────────────────────────────────────────
# The third API-booked courier, brought in for dispatch accuracy rather than for
# price. Across the Ajman, Dubai and Umm al-Quwain zones its car costs about AED
# 0.94 an order more than Lalamove; Ajman alone is cheaper on all eleven measured
# areas, because Lalamove's 17 AED base is high and Ajman is close. Leave the key
# empty and every Slider zone falls back to the courier that carries it today,
# exactly as the other two do.
SLIDER_API_KEY=
SLIDER_ACCOUNT_ID=
# `staging`, `production`, or an absolute https:// origin, which wins over both.
# `staging` is https://api-sandbox.slider-app.com/v1 and `production` is
# https://api.slider-app.com/v1; both were confirmed live on 2026-08-21. The
# override stays for the day those move — a wrong host fails as DNS on the
# first real booking, and this fixes it without a deploy.
SLIDER_ENV=staging
SLIDER_TIMEOUT_SECONDS=8
# The vehicle rule, and the whole of it: a bike if the drop is in the SAME
# EMIRATE as the kitchen AND the route is no more than this many ROAD km; a car
# otherwise. Both conditions — a bike may not cross an emirate boundary, so from
# the Sharjah kitchen the bike tier is only usable inside Sharjah.
#
# Slider's own API disagrees: /deliveries/fare offered a bike for Sharjah->Ajman
# at 12 km and for nine Sharjah->Dubai routes out to 34.4 km. Until somebody at
# Slider answers that in writing we take the stricter reading, which costs about
# AED 5 an order across Ajman and Dubai.
SLIDER_BIKE_MAX_KM=35
# Straight line to road distance, measured across the 97 areas of the fare
# survey (1.44 mean, 1.24 median). Used only when Slider has not told us a
# distance themselves — their fare response carries the one they bill against.
SLIDER_DETOUR_FACTOR=1.44
# The static token Slider presents on the production webhook, and the header
# they present it in. They do not sign requests, so this pair is the entire
# check — and unlike the noon Send key above it is ENFORCED: an empty token
# rejects every push. Set the same two values in Slider's dashboard under
# Webhook URL / Token / Token Header Key.
SLIDER_WEBHOOK_TOKEN=
SLIDER_WEBHOOK_HEADER=X-Slider-Token
# The same pair for their STAGING webhook, which their dashboard configures
# separately and which we point at production on purpose:
# https://<prod-host>/api/v1/webhooks/slider/staging. That endpoint acknowledges
# and journals and writes nothing else, so real Slider traffic can be watched
# while the integration is being proved. Rows appear in Admin -> Webhook logs as
# provider `slider`, endpoint `staging`; LOG_RETENTION_DAYS is 7.
SLIDER_STAGING_WEBHOOK_TOKEN=
SLIDER_STAGING_WEBHOOK_HEADER=X-Slider-Token
# The accounts running the pilot on production. Comma-separated, matched against
# a SIGNED-IN customer's own account email — a guest typing one of these never
# qualifies. Being on it grants both halves of the pilot at once: Slider carries
# the order, and its delivery is free. Emptying it ends both together, which is
# the point of there being one switch. Empty is the shipping default.
SLIDER_TRIAL_EMAILS=

# ─── Routing (how far the driver is from the kitchen) ────────────────────────
# Mapbox Directions, `driving-traffic`. Answers the one question neither courier
# does: not where the rider is, but how long they are from the counter. The
# straight line between two pins does not know about the creek, the one-ways
# round Al Majaz, or which bridge is in the way — a driver 2 km away as the crow
# flies can be 6 km of road.
#
# OPTIONAL. Empty falls back to straight-line x NOON_SEND_DETOUR_FACTOR, which is
# what shipped before this existed: the screens show a distance and no ETA. A
# missing token must cost precision, never a blank screen or a failed webhook.
#
# A `pk.` public token — the Directions API needs no scope, and any secret scope
# would make it an `sk.` token with a far larger blast radius. Do NOT add a URL
# restriction: Mapbox enforces those on the HTTP `Referer` header, which a
# server request does not send, so a restricted token rejects every call we make
# with an error that reads like a bad key.
MAPBOX_ACCESS_TOKEN=
# Seconds between route refreshes for one delivery. noon Send pushes a position
# every 15-30s; without a floor one order would ask Mapbox four times a minute
# to re-answer a question whose answer has not changed.
MAPBOX_MIN_ROUTE_INTERVAL_S=60
# Short: this runs inside the batch sweep, which has cakes waiting on it.
MAPBOX_TIMEOUT_S=5.0

# ─── Log retention (how long the debugging trails are kept) ──────────────────
# webhook_logs, email_logs and webhook_events are debugging output, and the
# question they answer — "did this arrive, did that send" — is asked within
# hours. webhook_logs is also the fastest-growing table we have: noon Send push
# a rider position every 15-30 seconds per live task and every one is stored at
# full payload, which is only affordable because of this bound.
LOG_RETENTION_DAYS=7
# audit_logs is different in kind and kept far longer: not debugging output but
# the record of who changed what, wanted precisely when somebody disputes a
# change weeks later.
AUDIT_RETENTION_DAYS=90

# ─── Apple Push (waking the POS registers) ───────────────────────────────────
# The APNs auth key, as .p8 PEM. Team-scoped and account-wide: ONE key serves
# every app in the Apple team and both the sandbox and production hosts, and
# Apple caps an account at two — so this is the same key the other apps use, not
# a new one. Ours is Key ID CWXGV3TWNY, Team 2F94NY8R3T, local copy at
# ~/.apns/AuthKey_CWXGV3TWNY.p8 (Apple serves the file exactly once — back it up).
#
# As a GitHub secret it must be ONE LINE with literal \n between the PEM lines,
# because a multi-line secret does not survive the printf into .env. Convert with:
#   awk 'BEGIN{ORS="\\n"} {print}' ~/.apns/AuthKey_CWXGV3TWNY.p8
#
# Empty means no push: orders still arrive and the register still shows them
# when it polls, so this is a quieter shop rather than a broken one.
APNS_KEY_P8=
APNS_KEY_ID=
APNS_TEAM_ID=
# Bundled in the app. The repeating alarm is the app's own doing — iOS will not
# loop a notification sound, so the push is the doorbell and the app is the bell.
APNS_ORDER_SOUND=new-order.caf
APNS_TIMEOUT_SECONDS=10

# ─── Frontend URLs (used in email templates) ─────────────────────────────────
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
# Production: WEB_URL=https://meltingmomentscakes.com
# Production: ADMIN_URL=https://admin.meltingmomentscakes.com

# ─── Umami Cloud Analytics (optional) ────────────────────────────────────────
# Leave empty to disable traffic metrics on the analytics dashboard.
# Create an API key at: https://cloud.umami.is/settings/api-keys
UMAMI_API_KEY=
UMAMI_WEBSITE_ID=

# ─── GCP Cloud Logging ────────────────────────────────────────────────────────
# Project ID for the gcplogs Docker logging driver (docker-compose.prod.yml).
# On GCE instances the driver auto-detects the project — you can leave this
# empty. Only set it when running outside GCE (e.g. local test of prod compose).
# Prereq: VM service account must have roles/logging.logWriter.
GCP_PROJECT_ID=

# ─── Sentry (error tracking, optional) ───────────────────────────────────────
# Leave empty to disable. Use the DSN from Sentry project: mm-backend.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0
# Production: SENTRY_ENVIRONMENT=production

# ─── Cloudflare Turnstile (bot check on signup and password reset) ───────────
# Empty disables the check entirely, at both ends — the storefront renders no
# widget and the API asks for no token. That is deliberate: deploying before
# the keys exist must not lock real customers out of signing up.
#
# Keys: dash.cloudflare.com -> Turnstile -> Add site. The widget key is public
# and belongs in the web app as NEXT_PUBLIC_TURNSTILE_SITE_KEY; the secret goes
# here. Cloudflare's always-passes test secret is 1x0000000000000000000000000000000AA
# and its always-fails twin is 2x0000000000000000000000000000000AA — both are
# answered locally without touching the network.
# ── Firebase phone verification ──────────────────────────────────────────────
# The Firebase/GCP project whose ID tokens the API will accept. Not a secret —
# it is already in the browser bundle — but it IS the whole audience check, so a
# wrong value here accepts tokens minted by somebody else's Firebase project.
# Leave empty to switch phone verification off; it fails closed, not open.
#
# There is deliberately no service-account key. ID tokens verify against
# Google's published certificates, so the server needs nothing secret.
FIREBASE_PROJECT_ID=melting-moments-cakes
# How long a phone proof stays reusable, in seconds. Firebase refreshes ID
# tokens hourly but keeps `auth_time` from the original sign-in, so without this
# a months-old session still looks freshly verified. 0 disables the check.
FIREBASE_MAX_AUTH_AGE_SECONDS=3600
FIREBASE_TIMEOUT_SECONDS=5.0
# How long a completed phone proof stays good for, in seconds. Separate from the
# token's own freshness above: that one is about replay, this one is about not
# making a customer verify twice between saving an address and paying. 30 days.
PHONE_VERIFICATION_TTL_SECONDS=2592000

TURNSTILE_SECRET_KEY=
TURNSTILE_TIMEOUT_SECONDS=5

# Offsite backup target. Empty means the nightly dump stays on the VM's own
# disk, which is not a backup — see PRODUCTION.md Step 8.
BACKUP_GCS_BUCKET=
# The in-process loop that dispatches a delivery batch when its window closes.
# On in the API; deliberately off in the register, which shares this Settings
# object but must not run a second sweeper against the same rows.
BATCH_DISPATCHER_ENABLED=true
