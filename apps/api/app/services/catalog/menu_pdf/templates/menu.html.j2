<!DOCTYPE html>
<html lang="{{ doc.lang }}" dir="{{ doc.direction }}">
<head>
<meta charset="utf-8" />
<style>
/* ── Bundled fonts (OFL) ─────────────────────────────────────────────── */
@font-face { font-family:'Poppins'; font-weight:400; font-style:normal;
  src:url('{{ font_uri("Poppins-Regular.ttf") }}'); }
@font-face { font-family:'Poppins'; font-weight:400; font-style:italic;
  src:url('{{ font_uri("Poppins-Italic.ttf") }}'); }
@font-face { font-family:'Poppins'; font-weight:500; font-style:normal;
  src:url('{{ font_uri("Poppins-Medium.ttf") }}'); }
@font-face { font-family:'Poppins'; font-weight:600; font-style:normal;
  src:url('{{ font_uri("Poppins-SemiBold.ttf") }}'); }
@font-face { font-family:'Poppins'; font-weight:700; font-style:normal;
  src:url('{{ font_uri("Poppins-Bold.ttf") }}'); }
@font-face { font-family:'Marcellus'; font-weight:400; font-style:normal;
  src:url('{{ font_uri("Marcellus-Regular.ttf") }}'); }
@font-face { font-family:'Almarai'; font-weight:300; font-style:normal;
  src:url('{{ font_uri("Almarai-Light.ttf") }}'); }
@font-face { font-family:'Almarai'; font-weight:400; font-style:normal;
  src:url('{{ font_uri("Almarai-Regular.ttf") }}'); }
@font-face { font-family:'Almarai'; font-weight:700; font-style:normal;
  src:url('{{ font_uri("Almarai-Bold.ttf") }}'); }
@font-face { font-family:'Almarai'; font-weight:800; font-style:normal;
  src:url('{{ font_uri("Almarai-ExtraBold.ttf") }}'); }

:root {
  --page-bg: {{ doc.theme.page_bg }};
  --panel-bg: {{ doc.theme.panel_bg }};
  --ink: {{ doc.theme.ink }};
  --muted: {{ doc.theme.muted }};
  --accent: {{ doc.theme.accent }};
  --price-ink: {{ doc.theme.price_ink }};
  --hairline: {{ doc.theme.hairline }};
  {% if doc.lang == 'ar' %}
  --display: 'Almarai', 'Poppins', sans-serif;
  --body: 'Almarai', 'Poppins', sans-serif;
  {% else %}
  --display: '{{ doc.theme.display_font }}', 'Poppins', serif;
  --body: '{{ doc.theme.body_font }}', 'Poppins', sans-serif;
  {% endif %}
}

@page {
  size: A4;
  margin: 21mm 11mm 16mm 11mm;
  background: var(--page-bg);
  @top-center { content: element(masthead); vertical-align: middle; }
  @bottom-center { content: element(contactbar); vertical-align: middle; }
}

* { box-sizing: border-box; }
html { background: var(--page-bg); }
body {
  margin: 0; padding: 0;
  color: var(--ink);
  font-family: var(--body);
  font-size: 9.4pt;
  line-height: 1.3;
  -weasy-hyphens: none;
}

/* ── Running masthead — a centered lockup, repeated on every page ──────── */
.masthead {
  position: running(masthead);
  text-align: center; line-height: 1.06;
}
.masthead .logo { height: 12.5mm; width: auto; margin-bottom: 1mm; }
.masthead .logo.circle { border-radius: 50%; }
.masthead .logo.rounded { border-radius: 2mm; }
.masthead .brand {
  font-family: var(--display); color: var(--ink);
  font-size: 18pt; letter-spacing: .4px; display: block;
}
.masthead .kicker {
  font-family: var(--body); font-weight: 600; font-size: 7pt;
  letter-spacing: 3.2px; text-transform: uppercase; color: var(--accent);
  margin-top: 1mm;
}
.masthead .kicker .dot { opacity: .55; margin: 0 1.6mm; }

/* ── Running contact bar — one centered line, repeated on every page ───── */
.contactbar {
  position: running(contactbar);
  display: flex; align-items: center; justify-content: center;
  gap: 3mm; white-space: nowrap;
}
.contactbar .qr { width: 11mm; height: 11mm; flex: none; }
.contactbar .qr svg { width: 11mm; height: 11mm; display: block; }
.contactbar .clabel {
  font-weight: 600; font-size: 7pt; letter-spacing: 2px; text-transform: uppercase;
  color: var(--accent); white-space: nowrap;
}
.contactbar .cnum { font-weight: 700; font-size: 11.5pt; color: var(--ink);
  direction: ltr; unicode-bidi: isolate; white-space: nowrap; }

/* ── Two-column flow ──────────────────────────────────────────────────────
   A single A4-wide column left ~60% of every row empty between the name and
   its price. Two columns halve the page count; each category is kept whole
   (break-inside: avoid) so a section never strands an item on the next
   column or page. A category taller than a whole column can't be kept whole —
   then the head stays with its first two items and the last two stay together,
   so a split never leaves a lone row behind. */
.menu { column-count: 2; column-gap: 9mm; column-fill: auto; }
.section { margin: 0 0 4.6mm 0; break-inside: avoid; }
.section-head {
  display: flex; align-items: center; gap: 2mm;
  margin: 0 0 1.4mm 0; break-after: avoid;
}
.section-head .ic { color: var(--accent); display: flex; align-items: center; }
.section-head .ic svg { width: 4.2mm; height: 4.2mm; }
.section-title {
  font-family: var(--display);
  {% if doc.theme.title_uses_display and doc.lang != 'ar' %}
  font-size: 14.5pt; font-weight: 400; letter-spacing: .4px;
  {% else %}
  font-size: 11.8pt; font-weight: 700; letter-spacing: .2px;
  {% endif %}
  color: var(--ink); white-space: nowrap;
  {% if doc.theme.uppercase_titles and doc.lang != 'ar' %}text-transform: uppercase;{% endif %}
}
.section-rule { flex: 1; height: 0; border-top: 0.8pt solid var(--hairline); }
.colhead { display: flex; justify-content: flex-end; align-items: flex-end; gap: 0;
  margin: 0.4mm 0 0.4mm 0; break-after: avoid; }
/* A size label wider than its cell ("6 Pieces") wraps onto two lines rather
   than running into its neighbour. */
.colhead .cell {
  width: 12.5mm; padding: 0 .5mm; text-align: center; font-weight: 600; font-size: 6.3pt;
  line-height: 1.1; letter-spacing: .3px; text-transform: uppercase; color: var(--accent);
}

/* ── Items ──────────────────────────────────────────────────────────────
   align-items: center lines the thumbnail and the price up with the middle of
   the text, whether the row is a bare name or a name over a two-line
   description (flex-start pinned the name to the top of the photo). */
.item {
  display: flex; align-items: center; gap: 2.6mm;
  padding: 1.25mm 0; break-inside: avoid;
  border-bottom: 0.4pt solid color-mix(in srgb, var(--hairline) 55%, transparent);
}
.item.last { border-bottom: 0; }
.item.keep-next { break-after: avoid; }
.thumb {
  width: 11mm; height: 11mm; border-radius: 50%; object-fit: cover;
  border: 0.5pt solid var(--hairline); flex: none;
  background: color-mix(in srgb, var(--panel-bg) 70%, white);
}
.item .body { flex: 1; min-width: 0; }
.item .name {
  font-weight: 600; font-size: 9.6pt; color: var(--ink); line-height: 1.2;
}
.item .desc {
  color: var(--muted); font-size: 7.4pt; font-style: italic; line-height: 1.25;
  margin-top: .3mm;
}
.item .chips { margin-top: .6mm; display: flex; flex-wrap: wrap; gap: 1mm 2.6mm; }
.item .chip { font-size: 8pt; color: var(--ink); white-space: nowrap; }
.item .chip b { font-weight: 700; }
.item .chip .sz { color: var(--accent); font-weight: 600; margin-inline-end: .8mm;
  font-size: 7pt; letter-spacing: .4px; text-transform: uppercase; }

.item .price { flex: none; text-align: {{ 'left' if doc.direction == 'rtl' else 'right' }}; }
.item .price .amt { font-weight: 700; font-size: 10.4pt; color: var(--price-ink); }
.item .price .pfx { font-size: 6.6pt; color: var(--muted); font-weight: 500;
  display: block; letter-spacing: .4px; }
.item .cells { display: flex; justify-content: flex-end; }
.item .cells .cell { width: 12.5mm; text-align: center; font-weight: 700;
  font-size: 9.6pt; color: var(--price-ink); }
.item .cells .cell.empty { color: var(--hairline); font-weight: 400; }
</style>
</head>
<body>

<div class="masthead">
  {% if doc.logo_data_uri %}
    <img class="logo {{ doc.theme.logo_shape }}" src="{{ doc.logo_data_uri }}" alt="" />
  {% else %}
    <span class="brand">{{ doc.brand_name }}</span>
  {% endif %}
  <div class="kicker">{{ doc.title }}{% if doc.branch_name %}<span class="dot">•</span>{{ doc.branch_name }}{% endif %}</div>
</div>

<div class="contactbar">
  {% if doc.qr_svg %}<div class="qr">{{ doc.qr_svg|safe }}</div>{% endif %}
  {% if doc.whatsapp_number %}
  <span class="clabel">{{ 'اطلب عبر واتساب' if doc.lang == 'ar' else 'Order on WhatsApp' }}</span>
  <span class="cnum">{{ doc.whatsapp_number }}</span>
  {% endif %}
</div>

<div class="menu">
{% for section in doc.sections %}
{% set n_items = section.blocks|sum(attribute="items", start=[])|length %}
{% set ns = namespace(i=0) %}
<div class="section">
  <div class="section-head">
    <span class="ic">{{ icon(section.icon_key)|safe }}</span>
    <span class="section-title">{{ section.title }}</span>
    <span class="section-rule"></span>
  </div>
  {% for block in section.blocks %}
  {% if block.columns %}
  <div class="colhead">
    {% for col in block.columns %}<span class="cell">{{ col }}</span>{% endfor %}
  </div>
  {% endif %}
  {% for item in block.items %}
  {% set ns.i = ns.i + 1 %}
  <div class="item{{ ' keep-next' if ns.i < n_items and (ns.i < 2 or ns.i == n_items - 1) else '' }}{{ ' last' if ns.i == n_items else '' }}">
    {% if item.image_data_uri %}<img class="thumb" src="{{ item.image_data_uri }}" alt="" />{% endif %}
    <div class="body">
      <div class="name">{{ item.name }}</div>
      {% if item.description %}<div class="desc">{{ item.description }}</div>{% endif %}
      {% if item.variants and not item.column_prices %}
      <div class="chips">
        {% for v in item.variants %}
        <span class="chip"><span class="sz">{{ v.label }}</span><b>{{ v.price }}</b></span>
        {% endfor %}
      </div>
      {% endif %}
    </div>
    <div class="price">
      {% if block.columns and item.column_prices %}
      <div class="cells">
        {% for p in item.column_prices %}
        <span class="cell {{ 'empty' if not p else '' }}">{{ p or '·' }}</span>
        {% endfor %}
      </div>
      {% elif block.columns and item.single_price %}
      {# One price in a sized block: centre it across the whole grid so it
         stays inside the columns instead of floating past them. #}
      <div class="cells">
        <span class="cell" style="width: {{ block.columns|length * 12.5 }}mm">{{ item.single_price }}</span>
      </div>
      {% elif item.single_price %}
      {% if item.price_prefix %}<span class="pfx">{{ item.price_prefix }}</span>{% endif %}
      <span class="amt">{{ item.single_price }}</span>
      {% endif %}
    </div>
  </div>
  {% endfor %}
  {% endfor %}
</div>
{% endfor %}
</div>

</body>
</html>
