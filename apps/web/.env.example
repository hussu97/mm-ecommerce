NEXT_PUBLIC_SITE_URL=https://meltingmomentscakes.com
# Dev: relative path — Next.js proxies /api/v1/* to NEXT_PRIVATE_API_HOST to keep cookies same-origin.
# Prod: set to the absolute HTTPS API URL (no proxy needed — API is on same-site domain).
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PRIVATE_API_HOST=http://localhost:8000
# Production: NEXT_PUBLIC_API_URL=https://api.meltingmomentscakes.com/api/v1

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
NEXT_PUBLIC_SUPPORTED_LOCALES=en,ar

# ─── Umami Cloud Analytics (optional) ────────────────────────────────────────
# Leave empty to disable client-side analytics tracking.
# Website ID from: https://cloud.umami.is/settings/websites
#
# The ID is the only part that belongs here. The analytics paths are internal to
# this app and hard-coded in `app/layout.tsx`; `NEXT_PUBLIC_UMAMI_URL` is no
# longer read, and a stale one deployed a tracker pointing at a 404.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# ─── Google Maps (optional) ──────────────────────────────────────────────────
# Required for the location pin selector on address forms.
# Enable: Maps JavaScript API + Places API (New) in Google Cloud Console.
# Map ID: create one at console.cloud.google.com/google/maps-apis/studio/maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# ─── Sentry (optional) ───────────────────────────────────────────────────────
# Leave empty to disable error tracking.
# Use the DSN from Sentry project: mm-frontend.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=1.0
NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0

# Cloudflare Turnstile widget key — public by design, it identifies the site
# rather than authorising anything. Empty renders no widget and sends no token,
# which the API treats as "check disabled". Set it in Vercel -> Settings ->
# Environment Variables for the web project, alongside TURNSTILE_SECRET_KEY on
# the API. Cloudflare's always-passes test key is 1x00000000000000000000AA.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
