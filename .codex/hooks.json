{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "code-review-graph update --skip-flows",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "case \"$CLAUDE_FILE_PATH\" in apps/web/*.ts|apps/web/*.tsx) pnpm --filter web exec tsc --noEmit 2>&1 | head -20 ;; apps/admin/*.ts|apps/admin/*.tsx) pnpm --filter admin exec tsc --noEmit 2>&1 | head -20 ;; esac",
            "timeout": 60000
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "code-review-graph status",
            "timeout": 3000
          }
        ]
      }
    ]
  }
}
